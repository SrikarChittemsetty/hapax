#!/bin/bash
# Bootstrap for the Hapax instance.
#
# Runs once at first boot. Its job: install Docker, log in to ECR with the
# instance role, fetch the database URL from SSM, and run the container under
# systemd so it comes back after a reboot.
#
# The secret is read at *start time* from SSM into the unit's environment file,
# not baked into the image and not passed through Terraform into user data —
# user data is readable by anything on the instance that can reach the metadata
# service, so a password there is a password published locally.
set -euxo pipefail

exec > >(tee /var/log/hapax-bootstrap.log) 2>&1

dnf update -y
dnf install -y docker awscli
systemctl enable --now docker

REGION="${region}"
ECR_REPO="${ecr_repo}"
IMAGE_TAG="${image_tag}"
SSM_DB_PATH="${ssm_db_path}"
REGISTRY="$${ECR_REPO%%/*}"

# Log in to ECR using the instance role. No access keys on the box.
aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$REGISTRY"

docker pull "$ECR_REPO:$IMAGE_TAG"

# Fetch the connection string. --with-decryption is what makes SecureString
# readable, and the instance role permits it for this one parameter only.
install -d -m 0700 /etc/hapax
aws ssm get-parameter \
  --name "$SSM_DB_PATH" \
  --with-decryption \
  --region "$REGION" \
  --query 'Parameter.Value' \
  --output text > /etc/hapax/db_url

chmod 0600 /etc/hapax/db_url
printf 'HAPAX_DATABASE_URL=%s\n' "$(cat /etc/hapax/db_url)" > /etc/hapax/env
chmod 0600 /etc/hapax/env

cat > /etc/systemd/system/hapax.service <<UNIT
[Unit]
Description=Hapax durable task store
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=5
EnvironmentFile=/etc/hapax/env
ExecStartPre=-/usr/bin/docker rm -f hapax
ExecStart=/usr/bin/docker run --rm --name hapax \
  -e HAPAX_DATABASE_URL \
  --log-driver=json-file --log-opt max-size=10m --log-opt max-file=3 \
  $ECR_REPO:$IMAGE_TAG

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now hapax.service
echo "hapax started"

# --- Aporia ------------------------------------------------------------------
# Only when enabled. Runs alongside the Hapax dispatcher on the same instance;
# see aporia.tf for why the instance has to be at least 2 GB.
%{ if enable_aporia ~}
APORIA_REPO="${aporia_repo}"
APORIA_TAG="${aporia_tag}"
SSM_ANTHROPIC="${ssm_anthropic}"

docker pull "$APORIA_REPO:$APORIA_TAG"

# The Anthropic key is created empty by Terraform and set out of band, so it may
# legitimately still be the placeholder. Aporia degrades to unclassified results
# rather than failing, so a missing key is a warning, not a fatal error.
ANTHROPIC_KEY="$(aws ssm get-parameter --name "$SSM_ANTHROPIC" --with-decryption \
  --region "$REGION" --query 'Parameter.Value' --output text 2>/dev/null || echo "")"

if [ -z "$ANTHROPIC_KEY" ] || [ "$ANTHROPIC_KEY" = "PLACEHOLDER-set-with-aws-ssm-put-parameter" ]; then
  echo "WARNING: Anthropic key not set; Aporia will return passages unclassified." >&2
  ANTHROPIC_KEY=""
fi

printf 'ANTHROPIC_API_KEY=%s\n' "$ANTHROPIC_KEY" > /etc/hapax/aporia.env
chmod 0600 /etc/hapax/aporia.env

cat > /etc/systemd/system/aporia.service <<UNIT
[Unit]
Description=Aporia stance-aware philosophy search
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=5
EnvironmentFile=/etc/hapax/aporia.env
ExecStartPre=-/usr/bin/docker rm -f aporia
ExecStart=/usr/bin/docker run --rm --name aporia \
  -p 8080:8080 \
  -e ANTHROPIC_API_KEY \
  --memory=1200m \
  --log-driver=json-file --log-opt max-size=10m --log-opt max-file=3 \
  $APORIA_REPO:$APORIA_TAG

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now aporia.service
echo "aporia started"
%{ endif ~}

echo "bootstrap complete"
