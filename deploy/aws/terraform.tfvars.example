# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# Your address only. Get it with: curl -s https://checkip.amazonaws.com
ssh_ingress_cidr = "203.0.113.42/32"

# Contents of your public key, e.g. cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@laptop"

# region        = "us-east-1"
# instance_type = "t2.micro"   # see the warning in variables.tf before using t3.micro
